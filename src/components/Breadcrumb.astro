import { docsNavSections, type DocsNavItem } from "@/data/docsNav";

// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

const navigablePaths = new Set<string>();
const collectPaths = (items: DocsNavItem[]) => {
  for (const item of items) {
    navigablePaths.add(item.href.replace(/\/+$/, ""));
    if (item.children) collectPaths(item.children);
  }
};
for (const section of docsNavSections) {
  navigablePaths.add(section.href.replace(/\/+$/, ""));
  collectPaths(section.items);
}

