// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbList[0] === "posts") {
  breadcrumbList.splice(0, 2, `Posts (page ${breadcrumbList[1] || 1})`);
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${Number(breadcrumbList[2]) === 1 ? "" : "(page " + breadcrumbList[2] + ")"}`
  );
}
---

<nav class="app-layout mt-6 mb-2" aria-label="breadcrumb">
  <ul
    class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-foreground/48"
  >
    <li>
      <a href="/" class="transition-colors hover:text-foreground/72">Home</a>
    </li>
    {
      breadcrumbList.map((breadcrumb, index) => {
        const breadcrumbPath = `/${breadcrumbList.slice(0, index + 1).join("/")}/`;
        const displayName =
          labelMapping[breadcrumb] ||
          decodeURIComponent(breadcrumb).replace(/-/g, " ");
        const isLast = index + 1 === breadcrumbList.length;
        const isBlogIntermediate =
          breadcrumbList[0] === "blogs" && index > 0 && !isLast;
        const shouldLink =
          !isLast &&
          !isBlogIntermediate &&
          navigablePaths.has(breadcrumbPath.replace(/\/+$/, ""));

        return (
          <>
            <li aria-hidden="true" class="text-foreground/28">
              /
            </li>
            <li>
              {!shouldLink ? (
                <span
                  class:list={[
                    "text-foreground/68 capitalize",
                    { lowercase: index > 0 },
                  ]}
                  aria-current={isLast ? "page" : undefined}
                >
                  {displayName}
                </span>
              ) : (
                <a
                  href={breadcrumbPath}
                  class="capitalize transition-colors hover:text-foreground/72"
                >
                  {displayName}
                </a>
              )}
            </li>
          </>
        );
      })
    }
  </ul>
</nav>
