---
import type { DocsNavItem, DocsNavSection } from "@/data/docsNav";

type Props = {
  section: DocsNavSection;
  panel?: boolean;
};

const { section, panel = true } = Astro.props;
const currentPath =
  Astro.url.pathname.endsWith("/") && Astro.url.pathname !== "/"
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;

const isActive = (href: string) => currentPath === href;
const isOpen = (item: DocsNavItem) =>
  currentPath === item.href ||
  currentPath.startsWith(`${item.href}/`) ||
  Boolean(item.children?.some(isOpen));
---

<aside
  class:list={[
    panel && "surface-panel rounded-2xl border border-border p-4",
    !panel && "p-0",
  ]}
  data-docs-sidebar
>
  <a
    href={section.href}
    class="block rounded-xl px-3 py-2 text-sm font-semibold text-foreground transition-colors hover:bg-muted/50"
  >
    {section.title}
  </a>

  <nav class="mt-3" aria-label={`${section.title} navigation`}>
    <ul class="space-y-1 text-sm">
      {
        section.items.map(item => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "block rounded-xl px-3 py-2 text-foreground/68 transition-colors hover:bg-muted/50 hover:text-foreground",
                {
                  "bg-muted/60 font-medium text-foreground shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--accent)_18%,transparent)]":
                    isActive(item.href),
                },
              ]}
            >
              {item.title}
            </a>

            {item.children && (
              <ul
                class:list={[
                  "mt-1 space-y-1 border-s border-border ps-3",
                  { hidden: !isOpen(item) },
                ]}
              >
                {item.children.map(child => (
                  <li>
                    <a
                      href={child.href}
                      aria-current={isActive(child.href) ? "page" : undefined}
                      class:list={[
                        "block rounded-xl px-3 py-2 text-sm text-foreground/62 transition-colors hover:bg-muted/50 hover:text-foreground",
                        {
                          "bg-muted/60 font-medium text-foreground shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--accent)_18%,transparent)]":
                            isActive(child.href),
                        },
                      ]}
                    >
                      {child.title}
                    </a>

                    {child.children && (
                      <ul
                        class:list={[
                          "mt-1 space-y-1 border-s border-border ps-3",
                          { hidden: !isOpen(child) },
                        ]}
                      >
                        {child.children.map(grandchild => (
                          <li>
                            <a
                              href={grandchild.href}
                              aria-current={
                                isActive(grandchild.href) ? "page" : undefined
                              }
                              class:list={[
                                "block rounded-xl px-3 py-2 text-sm text-foreground/58 transition-colors hover:bg-muted/50 hover:text-foreground",
                                {
                                  "bg-muted/60 font-medium text-foreground shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--accent)_18%,transparent)]":
                                    isActive(grandchild.href),
                                },
                              ]}
                            >
                              {grandchild.title}
                            </a>

                            {grandchild.children && (
                              <ul
                                class:list={[
                                  "mt-1 space-y-1 border-s border-border ps-3",
                                  { hidden: !isOpen(grandchild) },
                                ]}
                              >
                                {grandchild.children.map(greatGrandchild => (
                                  <li>
                                    <a
                                      href={greatGrandchild.href}
                                      aria-current={
                                        isActive(greatGrandchild.href)
                                          ? "page"
                                          : undefined
                                      }
                                      class:list={[
                                        "block rounded-xl px-3 py-2 text-sm text-foreground/54 transition-colors hover:bg-muted/50 hover:text-foreground",
                                        {
                                          "bg-muted/60 font-medium text-foreground shadow-[inset_0_0_0_1px_color-mix(in_srgb,var(--accent)_18%,transparent)]":
                                            isActive(greatGrandchild.href),
                                        },
                                      ]}
                                    >
                                      {greatGrandchild.title}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
