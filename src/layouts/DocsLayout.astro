---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import DocsSidebar from "@/components/DocsSidebar.astro";
import { getDocsNavSection } from "@/data/docsNav";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{
  title: string;
  description?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
}>;

const { frontmatter } = Astro.props;
const docsSection = getDocsNavSection(Astro.url.pathname);
const hasDocsSection = Boolean(docsSection);

const toDate = (value: unknown) => {
  if (!value) return undefined;
  if (value instanceof Date) return value;

  const date = new Date(String(value));
  return Number.isNaN(date.getTime()) ? undefined : date;
};

const pubDatetime = toDate(frontmatter.pubDatetime);
const modDatetime = toDate(frontmatter.modDatetime);
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  description={frontmatter.description}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.0/dist/katex.min.css"
  />

  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pt-6 pb-16">
    {
      hasDocsSection && docsSection && (
        <div class="mb-6 lg:hidden">
          <details class="surface-panel rounded-2xl border border-border p-4">
            <summary class="cursor-pointer text-sm font-semibold text-foreground">
              {docsSection.title} contents
            </summary>
            <div class="mt-4">
              <DocsSidebar section={docsSection} panel={false} />
            </div>
          </details>
        </div>
      )
    }

    <div
      class:list={[
        hasDocsSection
          ? "grid gap-8 xl:grid-cols-[280px_minmax(0,1fr)] xl:items-start"
          : "grid",
      ]}
    >
      {
        hasDocsSection && docsSection && (
          <div class="hidden xl:sticky xl:top-28 xl:block xl:max-h-[calc(100vh-8rem)] xl:overflow-y-auto xl:pr-1">
            <DocsSidebar section={docsSection} />
          </div>
        )
      }

      <section
        id="about"
        data-pagefind-body
        class:list={[
          "app-prose min-w-0 prose-img:border-0",
          hasDocsSection
            ? "mx-auto max-w-4xl xl:mx-0 xl:max-w-none"
            : "mx-auto max-w-4xl",
        ]}
      >
        <h1>{frontmatter.title}</h1>
        <slot />
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  const renderMermaidDiagrams = async () => {
    const diagrams = Array.from(
      document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"]')
    );
    if (diagrams.length === 0) return;

    const { default: mermaid } = await import("mermaid");

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: "strict",
      theme: document.documentElement.classList.contains("dark")
        ? "dark"
        : "default",
    });

    for (const [index, pre] of diagrams.entries()) {
      // Expressive Code renders each source line in its own block element.
      // innerText preserves those visual newlines; textContent collapses them.
      const definition = pre.innerText.trim();
      if (!definition) continue;

      try {
        const { svg } = await mermaid.render(
          `mermaid-${Date.now()}-${index}`,
          definition
        );
        const diagram = document.createElement("div");
        diagram.className = "mermaid-diagram";
        diagram.setAttribute("role", "img");
        diagram.innerHTML = svg;
        (pre.closest(".expressive-code") ?? pre).replaceWith(diagram);
      } catch (error) {
        console.error("Unable to render Mermaid diagram", error);
      }
    }
  };

  document.addEventListener("astro:page-load", renderMermaidDiagrams);
</script>

<style is:global>
  :root {
    --sl-color-accent: var(--color-accent, #007acc);
    --sl-color-bg-inline-code: var(--color-fill, #f4f4f4);
  }

  starlight-tabs {
    display: block;
    max-width: 100%;
    min-width: 0;
    margin: 1.5rem 0;
  }

  starlight-tabs div[role="tabpanel"] {
    min-width: 0;
  }

  .starlight-aside {
    padding: 1rem 1.1rem;
    margin: 1.5rem 0;
    border-left: 0.25rem solid var(--sl-color-accent);
    background-color: color-mix(in srgb, var(--color-muted) 75%, transparent);
    border-radius: 0 1rem 1rem 0;
  }

  .mermaid-diagram {
    margin: 1.5rem 0;
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background: var(--color-card);
  }

  .mermaid-diagram svg {
    display: block;
    min-width: 36rem;
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
</style>
