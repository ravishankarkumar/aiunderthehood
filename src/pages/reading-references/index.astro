---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/config";

const currentlyReading = [
  {
    title:
      "An Introduction to Statistical Learning: with Applications in Python",
    type: "Book",
    author:
      "Gareth James, Daniela Witten, Trevor Hastie, Robert Tibshirani, and Jonathan Taylor",
    focus:
      "Building a more rigorous statistical foundation for machine learning work.",
  },
  {
    title: "IIT Bombay Certificate in Agentic AI for Working Professionals",
    type: "Certification",
    author: "IIT Bombay / Great Learning",
    href: "https://www.mygreatlearning.com/iit-bombay-agentic-ai",
    focus:
      "A structured way to test and strengthen my understanding of agentic systems.",
  },
];

const finishedReading = [
  {
    title: "Kubernetes in Action, Second Edition",
    type: "Book",
    author: "Marko Luksa",
    status: "Selective Study",
    subject: "Systems & Infrastructure",
  },
  {
    title: "Head First Design Patterns",
    type: "Book",
    author: "Eric Freeman, Elisabeth Robson, Bert Bates, and Kathy Sierra",
    status: "Studied",
    subject: "Software Engineering",
  },
  {
    title: "Design Patterns: Elements of Reusable Object-Oriented Software",
    type: "Book",
    author: "Erich Gamma, Richard Helm, Ralph Johnson, and John Vlissides",
    status: "Reference",
    subject: "Software Engineering",
  },
  {
    title: "System Design Interview: An Insider's Guide",
    type: "Book",
    author: "Alex Xu / ByteByteGo",
    status: "Studied",
    subject: "Software Engineering",
  },
  {
    title: "System Design Interview: An Insider's Guide, Volume 2",
    type: "Book",
    author: "Alex Xu / ByteByteGo",
    status: "Studied",
    subject: "Software Engineering",
  },
  {
    title: "The Hundred-Page Machine Learning Book",
    type: "Book",
    author: "Andriy Burkov",
    status: "Studied",
    subject: "AI & Machine Learning",
  },
  {
    title: "Artificial Intelligence Strategy",
    type: "Executive Education Programme",
    author: "Indian Institute of Management Bangalore (IIM Bangalore)",
    href: "https://eep.iimb.ac.in/course/artificial-intelligence-strategy/",
    status: "Completed · Batch 8",
    subject: "AI & Machine Learning",
  },
  {
    title: "Principles of Building AI Agents",
    type: "Book",
    author: "Sam Bhagwat / Mastra",
    href: "https://mastra.ai/books/principles-of-building-ai-agents",
    status: "Studied",
    subject: "AI & Machine Learning",
  },
  {
    title: "An Intuitive Introduction to Probability",
    type: "Course",
    author: "University of Zurich",
    href: "https://www.coursera.org/account/accomplishments/verify/Z9B06UTIC0QB",
    status: "Studied",
    subject: "Mathematics",
  },
  {
    title: "Mathematics for Machine Learning",
    type: "Specialization",
    author: "Imperial College London",
    href: "https://www.coursera.org/account/accomplishments/specialization/NPL2JFFPCHVS",
    status: "Studied",
    subject: "Mathematics",
  },
  {
    title: "Mathematics for Machine Learning and Data Science",
    type: "Specialization",
    author: "DeepLearning.AI",
    href: "https://www.coursera.org/account/accomplishments/specialization/Z86ELYTGH8FU",
    status: "Studied",
    subject: "Mathematics",
  },
  {
    title: "Architecting with Google Compute Engine",
    type: "Specialization",
    author: "Google Cloud Training on Coursera",
    href: "https://www.coursera.org/account/accomplishments/specialization/certificate/TURAT6YCLTUY",
    status: "Studied",
    subject: "Systems & Infrastructure",
  },
  {
    title: "Architecting with Google Kubernetes Engine",
    type: "Specialization",
    author: "Google Cloud Training on Coursera",
    href: "https://www.coursera.org/account/accomplishments/specialization/certificate/C62WUTMSHGDS",
    status: "Studied",
    subject: "Systems & Infrastructure",
  },
];

const librarySections = [
  "Software Engineering",
  "AI & Machine Learning",
  "Mathematics",
  "Systems & Infrastructure",
].map(subject => ({
  subject,
  items: finishedReading.filter(item => item.subject === subject),
}));
---

<Layout
  title={`Reading & References | ${SITE.title}`}
  description="Books, courses, certifications, and notes that shape KAVRIQ's thinking on AI, machine learning, Kubernetes, infrastructure, and system design."
  schemaType="CollectionPage"
>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pt-6 pb-16" data-pagefind-body>
    <section class="pb-8">
      <p
        class="tech-label text-xs font-semibold tracking-[0.18em] text-accent uppercase"
      >
        Library
      </p>
      <h1
        class="mt-3 max-w-4xl text-4xl font-semibold tracking-tight sm:text-5xl"
      >
        Reading & References
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-foreground/70">
        Materials from my desk that shape how I think about AI, machine
        learning, infrastructure, and system design.
      </p>
    </section>

    <aside aria-label="Reading principle" class="pb-9">
      <p class="max-w-3xl text-sm leading-7 text-foreground/56 italic">
        The purpose of computing is insight, not numbers.
      </p>
      <p
        class="mt-2 text-xs font-medium tracking-[0.12em] text-foreground/36 uppercase"
      >
        Richard Hamming
      </p>
    </aside>

    <section class="min-w-0 space-y-16 pt-3" aria-label="Reading entries">
      <section id="currently-reading" class="scroll-mt-28">
        <div class="mb-6">
          <h2 class="text-2xl font-semibold tracking-tight text-foreground/92">
            Currently Exploring
          </h2>
        </div>

        <ul class="space-y-3">
          {
            currentlyReading.map(item => (
              <li class="surface-panel rounded-lg border border-border p-6 sm:p-7">
                <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(14rem,0.65fr)] md:gap-8">
                  <div class="min-w-0">
                    <p class="mb-2 text-[0.65rem] font-semibold tracking-[0.12em] text-foreground/52 uppercase">
                      {item.type}
                      {item.href && (
                        <span class="text-foreground/35"> / External</span>
                      )}
                    </p>
                    <h3 class="text-xl font-semibold tracking-tight text-foreground/88">
                      {item.href ? (
                        <a
                          href={item.href}
                          class="transition-colors hover:text-accent"
                          target="_blank"
                          rel="noreferrer"
                        >
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>
                    <p class="mt-2 text-sm text-foreground/52">{item.author}</p>
                  </div>
                  <p class="border-l-0 text-sm leading-6 text-foreground/58 md:border-l md:border-border md:pl-6">
                    {item.focus}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="finished-reading" class="scroll-mt-28">
        <div class="mb-6">
          <h2 class="text-2xl font-semibold tracking-tight text-foreground/92">
            Reading Shelf
          </h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-foreground/58">
            Books, courses, and references I have studied, selectively studied,
            or return to while working.
          </p>
        </div>

        <div class="space-y-10">
          {
            librarySections.map(section => (
              <section
                aria-labelledby={`library-${section.subject.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and")}`}
              >
                <h3
                  id={`library-${section.subject.toLowerCase().replaceAll(" ", "-").replaceAll("&", "and")}`}
                  class="border-b border-border pb-3 text-sm font-semibold tracking-tight text-structure"
                >
                  {section.subject}
                </h3>
                <ul class="grid gap-x-10 md:grid-cols-2">
                  {section.items.map(item => (
                    <li class="border-b border-border/70 py-5">
                      <div class="min-w-0">
                        <div class="flex flex-wrap items-center gap-2">
                          <p class="text-[0.65rem] font-semibold tracking-[0.12em] text-foreground/52 uppercase">
                            {item.type}
                            {item.href && (
                              <span class="text-foreground/35">
                                {" "}
                                / External
                              </span>
                            )}
                          </p>
                          <span class="rounded-full border border-border px-2 py-0.5 text-[0.65rem] font-medium text-foreground/52">
                            {item.status}
                          </span>
                        </div>
                        <h4 class="mt-2 text-sm font-semibold tracking-tight text-foreground/80">
                          {item.href ? (
                            <a
                              href={item.href}
                              class="transition-colors hover:text-accent"
                              target="_blank"
                              rel="noreferrer"
                            >
                              {item.title}
                            </a>
                          ) : (
                            item.title
                          )}
                        </h4>
                        <p class="mt-1 text-sm text-foreground/46">
                          {item.author}
                        </p>
                      </div>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>
    </section>
  </main>
  <Footer />
</Layout>
