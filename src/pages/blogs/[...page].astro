---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import DocsSidebar from "@/components/DocsSidebar.astro";
import { getDocsNavSection } from "@/data/docsNav";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { SITE } from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return paginate(getSortedPosts(posts), { pageSize: posts.length });
}) satisfies GetStaticPaths;

const allPosts = getSortedPosts(
  await getCollection("blog", ({ data }) => !data.draft)
);
const featuredPostSlugs = [
  "07-26-introducing-the-word-ai-tadka",
  "06-27-ai-hype-vs-reality-mid-2026-check-in",
  "05-03-hidden-data-problem-agentic-ai",
];

const featuredPosts = featuredPostSlugs
  .map(slug => allPosts.find(post => post.id.endsWith(slug)))
  .filter((post): post is CollectionEntry<"blog"> => Boolean(post))
  .slice(0, 3);

const docsSection = getDocsNavSection(Astro.url.pathname);
---

<Layout title={`Blogs | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout pb-10 pt-6">
    {
      docsSection && (
        <div class="mb-6 lg:hidden">
          <details class="surface-panel rounded-2xl border border-border p-4">
            <summary class="cursor-pointer text-sm font-semibold text-foreground">
              {docsSection.title} contents
            </summary>
            <div class="mt-4">
              <DocsSidebar section={docsSection} panel={false} />
            </div>
          </details>
        </div>
      )
    }

    <div class="grid gap-8 xl:grid-cols-[280px_minmax(0,1fr)] xl:items-start">
      {
        docsSection && (
          <div class="hidden xl:sticky xl:top-28 xl:block xl:max-h-[calc(100vh-8rem)] xl:overflow-y-auto xl:pr-1">
            <DocsSidebar section={docsSection} />
          </div>
        )
      }

      <div class="min-w-0">
        <section class="mb-12">
          <div class="mb-5">
            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">My Favourite Blogs</h1>
          </div>
          <ul class="space-y-5">
            {
              featuredPosts.map(post => (
                <li>
                  <a
                    class="text-lg font-semibold text-foreground underline-offset-4 transition-colors hover:text-accent hover:underline"
                    href={getPath(post.id, post.filePath)}
                  >
                    {post.data.title}
                  </a>
                  <p class="mt-1 max-w-3xl text-foreground/68">{post.data.description}</p>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
